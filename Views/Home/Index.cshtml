@using System.IO
@functions {
    // 辅助方法：获取文件大小并格式化为 MB
    public string GetFileSize(string path)
    {
        if (File.Exists(path))
        {
            var info = new FileInfo(path);
            double sizeMb = info.Length / (1024.0 * 1024.0);
            return $"~{sizeMb:F1} MB";
        }
        return "~0.0 MB";
    }

    // 辅助方法：获取文件最后修改日期
    public string GetFileDate(string path)
    {
        if (File.Exists(path))
        {
            return File.GetLastWriteTime(path).ToString("yyyy-MM-dd");
        }
        return "2026-10-15";
    }
}

@{
    // 定义 4 个文件的物理路径（区分 framework-dependency 和 self-contained 目录）
