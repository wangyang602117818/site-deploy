    <script>
        // 1. 切换语言控制
        const btns = document.querySelectorAll(".lang-btn");
        const enDoms = document.querySelectorAll(".lang-en");
        const zhDoms = document.querySelectorAll(".lang-zh");

        btns.forEach(btn => {
            btn.onclick = function() {
                const lang = this.dataset.lang;

                document.querySelectorAll(`.lang-btn`).forEach(b => b.classList.remove("active"));
                document.querySelectorAll(`.lang-btn[data-lang="${lang}"]`).forEach(b => b.classList.add("active"));

                if (lang === "en") {
                    enDoms.forEach(d => d.classList.add("show"));
                    zhDoms.forEach(d => d.classList.remove("show"));
                    document.documentElement.lang = "en";
                } else {
                    enDoms.forEach(d => d.classList.remove("show"));
                    zhDoms.forEach(d => d.classList.add("show"));
                    document.documentElement.lang = "zh-CN";
                }
                // 切换语言后重新计算一次滚动监听
                updateActiveSidebar();
            }
        });

        // 2. 监听页面滚动，实现左侧菜单随当前视口位置高亮
        function updateActiveSidebar() {
            // 获取当前显示的语言容器内的所有标题（h2, h3）
            const currentLangDoc = document.querySelector('.lang-en.show') || document.querySelector('.lang-zh.show');
            if (!currentLangDoc) return;

            const headings = currentLangDoc.querySelectorAll('h2[id], h3[id]');
            const sidebarLinks = document.querySelectorAll('.sidebar-nav.show a');

            let scrollPosition = window.scrollY + 100; // 偏移量，判断触发时机

            let currentActiveId = '';
            headings.forEach(heading => {
                if (heading.offsetTop <= scrollPosition) {
                    currentActiveId = heading.getAttribute('id');
                }
            });

            sidebarLinks.forEach(link => {
                link.classList.remove('active');
                const href = link.getAttribute('href');
                if (href === '#' + currentActiveId) {
                    link.classList.add('active');
                }
            });
        }

        window.addEventListener('scroll', updateActiveSidebar);
        window.addEventListener('load', updateActiveSidebar);
    </script>
</body>
</html>