    var file2Path = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "wwwroot", "files", "self-contained", "SiteDeploy.zip");
    var file3Path = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "wwwroot", "files", "framework-dependency", "SiteDeploy.Node.zip");
    var file4Path = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "wwwroot", "files", "self-contained", "SiteDeploy.Node.zip");
}

